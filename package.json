{
  "name": "cx-erp",
  "version": "1.0.0",
  "description": "Cipher Mutex ERP & CEO Dashboard",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "postinstall": "cd server && npm install && cd ../client && npm install --include=dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "seed": "cd server && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
